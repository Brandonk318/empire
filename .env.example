# Copy to .env and fill in. .env is git-ignored. Keys stay on the server:
# they are never logged, never sent to the browser, and never passed to the coding agent.

# --- Grok brain -------------------------------------------------------------
# Get a key at https://console.x.ai
XAI_API_KEY=
# Model name as listed in your xAI console
GROK_MODEL=grok-4
# auto = API if XAI_API_KEY is set, else an installed Grok CLI | xai | cli | mock (tests only)
GROWLORD_BRAIN=auto
# Grok CLI binary, if you use one (flags are detected from `grok --help`)
GROK_BIN=grok

# --- Coding agent -----------------------------------------------------------
# Claude Code by default. Log in once by running `claude` and typing /login.
CODING_AGENT_BIN=claude
BUILD_MAX_TURNS=40
BUILD_TIMEOUT_MIN=30
# Tools the agent may use without asking. Default has no open-ended shell, so a build
# cannot curl, email, or push anything. Widen deliberately, e.g. add Bash(npm run:*)
BUILD_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,Bash(ls:*),Bash(mkdir:*),Bash(cat:*),Bash(wc:*)

# --- Voice (optional) -------------------------------------------------------
# Any OpenAI-compatible /v1/audio/speech server. tts/kokoro_server.py uses this port.
KOKORO_URL=http://127.0.0.1:8880
KOKORO_VOICE=am_michael

# --- Server -----------------------------------------------------------------
# Always binds to 127.0.0.1
PORT=4747
